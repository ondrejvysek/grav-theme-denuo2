{% extends 'partials/base.html.twig' %}

{% set collection = page.collection() %}

{% block content %}
    {% set design = page.header.design|default({}) %}
    {% set heading = page.header.heading ?: design['text-header'] ?: page.title %}
    {% set intro = page.header.intro ?: design['text-lead'] %}
    {% set chips = denuo_chips(page) %}
    {% set active_tag = denuo_active_tag() %}
    {% set tag_base = page.url ~ '/tag' ~ config.system.param_sep %}
    {% set current_page = grav.uri.currentPage %}
    {% set featured = current_page == 1 and not active_tag and collection|length > 1 %}
    {# Category illustration (design.image in the category's .md), shown beside the heading. #}
    {% set illustration = denuo_local_image(design.image|default('')) %}

    <div class="d2-wrap">
        <header class="d2-page-head{{ illustration ? ' d2-page-head--media' }}">
            <div class="d2-page-head-text">
            <h1>{{ heading }}</h1>
            {% if intro %}<p class="d2-page-intro">{{ intro }}</p>{% endif %}
            {% if chips or active_tag %}
                <nav class="d2-filter" aria-label="{{ 'THEME_DENUO2.CATEGORY.FILTER'|t }}">
                    <ul class="d2-chips" role="list">
                        <li><a class="d2-chip" href="{{ page.url }}"{% if not active_tag %} aria-current="page"{% endif %}>{{ 'THEME_DENUO2.CATEGORY.ALL'|t }}</a></li>
                        {% for tag in chips %}
                            <li><a class="d2-chip" href="{{ tag_base ~ tag|url_encode }}"{% if tag == active_tag %} aria-current="page"{% endif %}>{{ tag }}</a></li>
                        {% endfor %}
                        {% if active_tag and active_tag not in chips %}
                            <li><a class="d2-chip" href="{{ tag_base ~ active_tag|url_encode }}" aria-current="page">{{ active_tag }}</a></li>
                        {% endif %}
                    </ul>
                </nav>
            {% endif %}
            </div>
            {% if illustration %}
                <div class="d2-page-head-media">
                    <img src="{{ illustration.url }}" width="{{ illustration.width }}" height="{{ illustration.height }}"
                         alt="" loading="eager" fetchpriority="high" decoding="async">
                </div>
            {% endif %}
        </header>

        {% if collection|length %}
            {% for child in collection %}
                {% set excluded = theme_var('category_chip_exclude')|default([])|map(tag => tag|lower) %}
                {% set tags = child.taxonomy.tag|default([])|filter(tag => tag|lower not in excluded and tag|lower != page.menu|lower) %}
                {% set label = (active_tag in tags ? active_tag : null)
                    ?: (tags|filter(tag => tag in chips)|first)
                    ?: (tags|first)
                    ?: page.menu %}
                {% if featured and loop.first %}
                    <div class="d2-featured">
                        {% include 'partials/card.html.twig' with {page: child, featured: true, eager: true, heading: 'h2', label: label} only %}
                    </div>
                    <ul class="d2-grid" role="list">
                {% else %}
                    {% if loop.first %}<ul class="d2-grid" role="list">{% endif %}
                    <li>{% include 'partials/card.html.twig' with {page: child, heading: 'h2', label: label, eager: loop.index <= 3 and not featured} only %}</li>
                {% endif %}
                {% if loop.last %}</ul>{% endif %}
            {% endfor %}
        {% else %}
            <div class="d2-empty">
                <p>{% if active_tag %}{{ 'THEME_DENUO2.CATEGORY.EMPTY_TAG'|t(active_tag) }}{% else %}{{ 'THEME_DENUO2.CATEGORY.EMPTY'|t }}{% endif %}</p>
                {% if active_tag %}<a class="d2-btn d2-btn--outline" href="{{ page.url }}">{{ 'THEME_DENUO2.CATEGORY.SHOW_ALL'|t }}</a>{% endif %}
            </div>
        {% endif %}

        {% if config.plugins.pagination.enabled and collection.params.pagination %}
            {% include 'partials/pagination.html.twig' with {base_url: page.url, pagination: collection.params.pagination} %}
        {% endif %}
    </div>
{% endblock %}

{#
    Search and social tags from denuo_metadata() (classes/Seo.php). The theme owns description,
    keywords, robots and every og:, article: and twitter: tag; values stored in a page's or the
    site's `metadata:` for those are not printed, other extra tags (verification codes …) are.
#}
{% if seo %}
    {% if seo.description and not simplesearch_is_search_page %}<meta name="description" content="{{ seo.description }}">{% endif %}
    {% if seo.keywords and not simplesearch_is_search_page %}<meta name="keywords" content="{{ seo.keywords }}">{% endif %}
    <meta name="robots" content="{{ simplesearch_is_search_page ? 'noindex, follow' : seo.robots }}">
{% endif %}
{% if seo and not seo.noindex and not simplesearch_is_search_page %}
    <meta property="og:site_name" content="{{ seo.site_name }}">
    <meta property="og:locale" content="{{ seo.locale }}">
    <meta property="og:type" content="{{ seo.social_type }}">
    <meta property="og:url" content="{{ seo.social_url }}">
    <meta property="og:title" content="{{ seo.social_title }}">
    {% if seo.description %}<meta property="og:description" content="{{ seo.description }}">{% endif %}
    {% if seo.image %}
        <meta property="og:image" content="{{ seo.image.url }}">
        <meta property="og:image:type" content="{{ seo.image.type }}">
        <meta property="og:image:width" content="{{ seo.image.width }}">
        <meta property="og:image:height" content="{{ seo.image.height }}">
        <meta property="og:image:alt" content="{{ seo.image.alt }}">
    {% endif %}
    {% if seo.article %}
        {% if seo.article.published %}<meta property="article:published_time" content="{{ seo.article.published }}">{% endif %}
        {% if seo.article.modified %}<meta property="article:modified_time" content="{{ seo.article.modified }}">{% endif %}
        {% if seo.article.author %}<meta property="article:author" content="{{ seo.article.author }}">{% endif %}
        {% if seo.article.section %}<meta property="article:section" content="{{ seo.article.section }}">{% endif %}
        {% for tag in seo.article.tags %}<meta property="article:tag" content="{{ tag }}">{% endfor %}
    {% endif %}
    <meta name="twitter:card" content="{{ seo.image ? 'summary_large_image' : 'summary' }}">
    {% if seo.x_site %}<meta name="twitter:site" content="{{ seo.x_site }}">{% endif %}
    {% if seo.x_creator %}<meta name="twitter:creator" content="{{ seo.x_creator }}">{% endif %}
    {% if seo.image %}<meta name="twitter:image:alt" content="{{ seo.image.alt }}">{% endif %}
{% endif %}
{% for meta in page.metadata %}
    {% set key = (meta.name ?: meta.property)|default('') %}
    {% if key and not (key matches '/^(og|twitter|article|fb):|^(description|keywords|robots)$/') %}
        <meta{% if meta.name %} name="{{ meta.name }}"{% endif %}{% if meta.http_equiv %} http-equiv="{{ meta.http_equiv }}"{% endif %}{% if meta.property %} property="{{ meta.property }}"{% endif %}{% if meta.content %} content="{{ meta.content }}"{% endif %}>
    {% endif %}
{% endfor %}
{% if seo.graph and not simplesearch_is_search_page %}
    <script type="application/ld+json">{{ seo.graph|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endif %}

{# Icon for a colour mode: value = light | sunset | dark. Decorative; the caller provides the text. #}
{% set icon_class = 'd2-mode-icon' ~ (extra_class|default('') ? ' ' ~ extra_class) %}
{% if value == 'light' %}
    <svg class="{{ icon_class }}" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.25" fill="currentColor" stroke="none"/>
        <path d="M12 2.5v2.2M12 19.3v2.2M21.5 12h-2.2M4.7 12H2.5M18.7 5.3l-1.55 1.55M6.85 17.15 5.3 18.7M18.7 18.7l-1.55-1.55M6.85 6.85 5.3 5.3"/>
    </svg>
{% elseif value == 'sunset' %}
    <svg class="{{ icon_class }}" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M6.5 15a5.5 5.5 0 0 1 11 0z" fill="currentColor" stroke="none"/>
        <path d="M2.5 15.5h19M5.5 19h13M9 22h6M12 3.5v2M4.7 7.7l1.4 1.4M19.3 7.7l-1.4 1.4"/>
    </svg>
{% else %}
    <svg class="{{ icon_class }}" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M20 14.6A8.5 8.5 0 0 1 9.4 4a8.5 8.5 0 1 0 10.6 10.6z" fill="currentColor"/>
        <path d="M17.2 3.2l.55 1.45 1.45.55-1.45.55-.55 1.45-.55-1.45-1.45-.55 1.45-.55z" fill="currentColor"/>
    </svg>
{% endif %}
